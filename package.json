{
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4"
  },
  "scripts": {
    "lint": "eslint \"services/**/*.ts\" \"shared/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"services/**/*.ts\" \"shared/**/*.ts\" --no-error-on-unmatched-pattern",
    "prepare": "husky",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run format"
    ]
  }
}
