// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["organization", "auth", "incident", "ingestion"]
}

////////////// ORGANIZATION SCHEMA //////////////

model Team {
  id                       String       @id @default(uuid()) @db.Uuid
  ownerId                  String       @map("owner_id") @db.Uuid
  owner                    User         @relation(fields: [ownerId], references: [id])
  name                     String       @unique
  description              String?
  rotationPeriodDays       Int          @default(7) @map("rotation_period_days")
  rotationStartDate        DateTime     @default(now()) @map("rotation_start_date")
  currentRotationIndex     Int          @default(0) @map("current_rotation_index")
  lastRotatedAt            DateTime     @default(now()) @map("last_rotated_at")
  escalationTimeoutMinutes Int          @default(5) @map("escalation_timeout_minutes")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  teamMembers              TeamMember[]
  incidents                Incident[]

  @@map("teams")
  @@schema("organization")
}

model TeamMember {
  id               Int              @id @default(autoincrement())
  userId           String           @unique @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id])
  teamId           String           @map("team_id") @db.Uuid
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  joinedAt         DateTime         @default(now()) @map("joined_at")
  unavailabilities Unavailability[]

  @@map("team_members")
  @@schema("organization")
}

model Unavailability {
  id         Int        @id @default(autoincrement())
  memberId   Int        @map("member_id")
  teamMember TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startDate  DateTime   @map("start_date")
  endDate    DateTime   @map("end_date")
  reason     String?
  createdAt  DateTime   @default(now()) @map("created_at")
  confirmed  Boolean    @default(false)

  @@unique([memberId, startDate, endDate], name: "unique_unavailability_window")
  @@map("unavailabilities")
  @@schema("organization")
}

////////////// AUTH SCHEMA //////////////

enum Role {
  SRE
  ENGINEER

  @@map("role")
  @@schema("auth")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  pendingEmail String?  @map("pending_email")
  passwordHash String?  @map("password_hash")
  role         Role
  googleId     String?  @unique @map("google_id")
  specialty    String?
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  resetTokens             ResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  apiKeys                 ApiKey[]

  ownedTeams        Team[]
  teamMembers       TeamMember[]
  assignedIncidents Incident[]   @relation("IncidentAssignee")

  @@map("users")
  @@schema("auth")
}

////////////// INCIDENT SCHEMA //////////////

model Incident {
  id             String    @id @default(uuid()) @db.Uuid
  teamId         String?   @map("team_id") @db.Uuid
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title          String
  service        String
  severity       String
  status         String    @default("open")
  assignedToId   String?   @map("assigned_to") @db.Uuid
  assignedTo     User?     @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  mttaSeconds    Int?      @map("mtta_seconds")
  mttrSeconds    Int?      @map("mttr_seconds")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([teamId], name: "idx_incidents_team")
  @@index([status], name: "idx_incidents_status")
  @@index([createdAt], name: "idx_incidents_created_at")
  @@map("incidents")
  @@schema("incident")
}

model InviteToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  email     String
  teamId    String   @map("team_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("invite_tokens")
  @@schema("auth")
}

model ResetToken {
  id    String @id @default(uuid()) @db.Uuid
  token String @unique

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reset_tokens")
  @@schema("auth")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verification_tokens")
  @@schema("auth")
}

////////////// ALERT SCHEMA //////////////

model ApiKey {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  keyPrefix String   @map("key_prefix") @db.VarChar(12)
  keyHash   String   @unique @map("key_hash")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([ownerId, name], name: "unique_owner_name")
  @@map("api_keys")
  @@schema("ingestion")
}
